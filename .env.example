# PaySLO Lab — example environment. Copy to .env and adjust. ALL VALUES ARE LAB-ONLY.
# WARNING: never put real credentials here. Everything is synthetic.

# Postgres (app DB)
POSTGRES_USER=lab_app
POSTGRES_PASSWORD=lab-only-change-me
POSTGRES_DB=payslo_lab
DATABASE_URL=postgres://lab_app:lab-only-change-me@127.0.0.1:5432/payslo_lab

# Read-only DB role for sql_exporter / trainees
LAB_RO_USER=lab_ro
LAB_RO_PASSWORD=lab-only-ro-change-me

# Gateway / banks / merchant
GATEWAY_PORT=3000
# U0: listener admin gateway loopback terpisah (Envoy memblokir /admin/*).
GATEWAY_ADMIN_PORT=3001
BANK_SIM_PORT=4000
MERCHANT_SINK_PORT=5000
MERCHANT_WEBHOOK_SECRET=lab-only-webhook-secret-change-me
GATEWAY_TIMEOUT_SECS=5
GATEWAY_TXN_TTL_SECS=600
SEED=42

# datadog-mock
DATADOG_MOCK_PORT=8126
DD_API_KEY=lab-only-dd-api-key

# PaySLO server
PAYSLO_PORT=8081

# Notifikasi lokal ntfy (lab-only, tanpa auth, hanya 127.0.0.1:8022)
NTFY_TOPIC=payslo-lab

# Mode mentor (U6): PIN pembuka /mentor — PEMBATAS SPOILER, bukan keamanan
# (lihat docs/mentor-guide.md). Kosong = mode mentor nonaktif.
MENTOR_PIN=1234

# Override URL sumber observability untuk lab serve (U7, semua opsional;
# default loopback di bawah). Ubah bila port compose digeser.
# PROM_URL=http://127.0.0.1:9090
# LAB_ALERTMANAGER_URL=http://127.0.0.1:9093
# LAB_GRAFANA_URL=http://127.0.0.1:3002
# LAB_LOKI_URL=http://127.0.0.1:3100
# LAB_TEMPO_URL=http://127.0.0.1:3200
# LAB_NTFY_URL=http://127.0.0.1:8022
# LAB_NTFY_TOPIC=payslo-lab

# Envoy ingress (host-bound to 127.0.0.1 in compose)
ENVOY_PORT=8080

# Build parallelism guard for 8 GB laptops
CARGO_BUILD_JOBS=2
