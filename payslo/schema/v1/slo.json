{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payslo-lab.local/schema/v1/slo.json",
  "title": "PaySLO SLO",
  "description": "Canonical PaySLO v1 SLO document (kind SLO).",
  "type": "object",
  "required": ["apiVersion", "kind", "name", "service", "objective", "window", "sli", "alerting", "targets"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"type": "string", "const": "payslo/v1"},
    "kind": {"type": "string", "const": "SLO"},
    "name": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
    "service": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "objective": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "window": {"type": "string", "minLength": 1},
    "sli": {
      "type": "object",
      "required": ["type", "source", "good", "total"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["success-ratio", "latency"]},
        "source": {"type": "string", "enum": ["metric"]},
        "good": {"type": "string", "minLength": 1},
        "total": {"type": "string", "minLength": 1}
      }
    },
    "alerting": {
      "type": "object",
      "required": ["burnRates", "runbook"],
      "additionalProperties": false,
      "properties": {
        "burnRates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["longWindow", "shortWindow", "burnRate", "severity"],
            "additionalProperties": false,
            "properties": {
              "longWindow": {"type": "string", "minLength": 1},
              "shortWindow": {"type": "string", "minLength": 1},
              "burnRate": {"type": "number", "exclusiveMinimum": 0},
              "severity": {"type": "string", "enum": ["page", "ticket"]}
            }
          }
        },
        "runbook": {"type": "string", "minLength": 1}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["backend"],
        "additionalProperties": false,
        "properties": {
          "backend": {"type": "string", "enum": ["prometheus", "datadog"]},
          "overrides": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    }
  }
}
